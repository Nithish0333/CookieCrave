# pyenv
#   For a library or package, you might want to ignore these files since the Python version
#   is elected by the tool chain. In that case, uncomment the following entities:
# .python-version

# pipenv
#   According to pypa/pipenv#1191, it is recommended to not commit Pipfile.lock into version control.
#   But it should be committed for projects (applications) that are not libraries.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
pdm.lock
#   pdm local configuration
.pdm-python
.pdm-build/

# PEP 582; used by e.g. github.com/pdm-project/pdm
__pypackages__/

